# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#
# With NOTHING set, the site still runs: every page renders signed-out and the
# wallet shows a "not connected" notice instead of throwing. Add the Supabase
# keys and auth comes on; add the Razorpay keys and top-ups come on.

# ---------------------------------------------------------------- Supabase --
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable "anon" key. Safe in the browser BY DESIGN — it is in the JS
# bundle. It is only safe because Row Level Security constrains what it can do,
# so never disable RLS on a table this key can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key bypasses RLS entirely. Server-side only.
# NEVER prefix it with NEXT_PUBLIC_ and never import it into a client component.
# REQUIRED for the Razorpay webhook: it arrives with no user session and has to
# write a wallet credit, which no client role may ever do.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- Razorpay --
#
# KEY_SECRET and WEBHOOK_SECRET are server-only. Neither may ever carry a
# NEXT_PUBLIC_ prefix: the key secret signs payment requests and the webhook
# secret authenticates incoming payment events, so either one in the browser
# bundle is a total compromise. (KEY_ID is public — Checkout needs it — but it
# is handed to the page through an API response, not through the bundle.)
#
# Test keys (rzp_test_…) are issued the moment you sign up, BEFORE KYC clears.
# Use them to run the whole flow end to end; switching to live is only a key
# swap. The wallet page shows a "Test mode" badge whenever the key is a test one.
#
# Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret

# Razorpay Dashboard → Settings → Webhooks. Point it at
#   https://your-domain/api/razorpay/webhook
# and subscribe to payment.captured and payment.failed.
# This secret is chosen by you when creating the webhook, not issued by them.
#
# For local testing, tunnel it:  npx untun tunnel http://localhost:3000
# RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-choose

# -------------------------------------------------------------------- Site --
# NEXT_PUBLIC_SITE_URL=https://lawfic.in
