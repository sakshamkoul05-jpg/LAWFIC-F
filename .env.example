# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#
# With NOTHING set, the site still runs: every page renders signed-out and the
# wallet shows a "not connected" notice instead of throwing. Add the Supabase
# keys and auth comes on; add the Razorpay keys and top-ups come on.

# ---------------------------------------------------------------- Supabase --
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable "anon" key. Safe in the browser BY DESIGN — it is in the JS
# bundle. It is only safe because Row Level Security constrains what it can do,
# so never disable RLS on a table this key can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key bypasses RLS entirely. Server-side only.
# NEVER prefix it with NEXT_PUBLIC_ and never import it into a client component.
# Used here by /api/wallet/topup, to record a payment intent before the user
# reaches Checkout. Nothing else in this app may touch it.
#
# The webhook does NOT read this key from here — it runs as a Supabase Edge
# Function in the backend repo, where the platform injects it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- Razorpay --
#
# KEY_SECRET is server-only and may never carry a NEXT_PUBLIC_ prefix: it signs
# payment requests, so it in the browser bundle is a total compromise. KEY_ID is
# public — Checkout needs it — but it is handed to the page through an API
# response rather than inlined into the bundle.
#
# Test keys (rzp_test_…) are issued the moment you sign up, BEFORE KYC clears.
# Use them to run the whole flow end to end; switching to live is only a key
# swap. The wallet page shows a "Test mode" badge whenever the key is a test one.
#
# Razorpay Dashboard → Settings → API Keys
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-key-secret

# There is NO webhook secret in this file. The webhook lives in the backend
# repo (LAWFIC-B) as a Supabase Edge Function, and its secret is set there:
#
#   npx supabase secrets set RAZORPAY_WEBHOOK_SECRET=your-secret
#
# Point Razorpay at:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/razorpay-webhook
#
# That URL exists as soon as the Supabase project does, so payments can be
# tested before this app is deployed anywhere.

# -------------------------------------------------------------------- Site --
# NEXT_PUBLIC_SITE_URL=https://lawfic.in
