# Copy to .env.local and fill in. .env* is gitignored — never commit real keys.
#
# With NOTHING set, the site still runs: every page renders signed-out and the
# wallet shows a "not connected" notice instead of throwing. Add the Supabase
# keys and auth comes on; add the Razorpay keys and top-ups come on.

# ---------------------------------------------------------------- Supabase --
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The publishable "anon" key. Safe in the browser BY DESIGN — it is in the JS
# bundle. It is only safe because Row Level Security constrains what it can do,
# so never disable RLS on a table this key can reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key bypasses RLS entirely. Server-side only.
# NEVER prefix it with NEXT_PUBLIC_ and never import it into a client component.
# Used here by /api/wallet/topup, to record a payment intent before the user
# reaches Checkout. Nothing else in this app may touch it.
#
# The webhook does NOT read this key from here — it runs as a Supabase Edge
# Function in the backend repo, where the platform injects it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------- Cashfree --
#
# Dashboard → Developers → API Keys. Two values, and NEITHER may ever carry a
# NEXT_PUBLIC_ prefix.
#
# That is stricter than it was with Razorpay, and the reason is worth knowing:
# Razorpay had a publishable key id that Checkout needed in the page, so one of
# its two values was public by design. Cashfree has no such thing. The browser
# is handed a `payment_session_id` minted for one order, which expires — so
# there is no long-lived public value in this integration at all, and anything
# from this section appearing in a client bundle is a straight leak.
#
# CASHFREE_CLIENT_ID=TEST1234567890abcdef
# CASHFREE_CLIENT_SECRET=cfsk_ma_test_...

# Which environment the keys belong to: sandbox or production.
#
# Unset, the app assumes SANDBOX unless the app id starts with TEST. That is
# the safe direction to be wrong in — a deployment that refuses real cards is
# an annoyance; one that silently takes them is an incident. Set it explicitly
# in production; `npm run doctor` warns when it cannot tell.
# CASHFREE_MODE=sandbox

# There is NO webhook secret in this file, and no separate webhook secret at
# Cashfree either — the CLIENT SECRET above signs the webhooks too. The webhook
# runs in the backend repo (LAWFIC-B) as a Supabase Edge Function, so the same
# value has to be set there as well:
#
#   npx supabase secrets set CASHFREE_CLIENT_SECRET=your-secret
#
# Point Cashfree (Dashboard → Developers → Webhooks) at:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/cashfree-webhook
#
# That URL exists as soon as the Supabase project does, so payments can be
# tested before this app is deployed anywhere.

# -------------------------------------------------------------------- Site --
#
# SET THIS IN PRODUCTION. Two things break quietly without it: the sign-in
# emails and everything a search engine reads.
#
# SEARCH ENGINES. Open Graph tags and canonical URLs are only valid as ABSOLUTE
# URLs, and this is what they are built from. Unset, the site assumes it is not
# public: robots.txt becomes "Disallow: /", every page carries noindex, and the
# sitemap is empty — so a preview deployment cannot get itself indexed and
# compete with the real site. That is the right default and a bad surprise in
# production, where it means the site is invisible to Google. See lib/seo.ts.
#
# The link in a sign-in email is built from this when it is set, and from the
# browser's own origin when it is not. Unset in production that means a code
# requested from a preview deployment mails a preview URL that later expires,
# and one requested from localhost mails a localhost link — which works on the
# machine that asked and nowhere else, including the phone the customer is
# reading their email on.
#
# No trailing slash; the app strips one anyway.
# NEXT_PUBLIC_SITE_URL=https://lawfic.pro
